function normalizarDia(texto) {
    if (!texto) return "";

    const t = texto.toString().toUpperCase();

    if (t.includes("SEG")) return "SEGUNDA";
    if (t.includes("TER")) return "TERÇA";
    if (t.includes("QUA")) return "QUARTA";
    if (t.includes("QUI")) return "QUINTA";
    if (t.includes("SEX")) return "SEXTA";
    if (t.includes("SÁB") || t.includes("SAB")) return "SÁBADO";

    return "";
}

