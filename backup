function processarBaseModalidade(dados) {

    const semanas = {};

    const turmas =
        dados[0]
        .slice(2)
        .filter(t => t);

    let ultima = "";

    for(let i = 1; i < dados.length; i++) {

        let r = [...dados[i]];

        if(r[0]) ultima = r[0];

        r[0] = ultima;

        if(!r[0]) continue;

        const [d,m,a] = r[0].split('/');

        const dt = new Date(a,m-1,d);

        const seg = new Date(
            dt.setDate(
                dt.getDate() - dt.getDay() + 1
            )
        ).toLocaleDateString('pt-BR');

        if(!semanas[seg])
            semanas[seg] = { dias:{} };

        if(!semanas[seg].dias[r[0]])
            semanas[seg].dias[r[0]] = [];

        semanas[seg].dias[r[0]].push(r);
    }

    return {
        semanas,
        turmas
    };
}
  
