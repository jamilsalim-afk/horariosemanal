function obterPeriodoRelatorio(dataStr, modalidade){

    // Integrado é anual.
    if(modalidade === "INTEGRADO")
        return "ANUAL";

    const [d,m,a] = dataStr.split('/');

    const data = new Date(a, m-1, d);
    data.setHours(0,0,0,0);

    const semestres =
        CALENDARIO_RELATORIO_SUPERIOR;

    for(let i=0;i<semestres.length;i++){

        const [di,mi,ai] =
            semestres[i].inicio.split('/');

        const [df,mf,af] =
            semestres[i].fim.split('/');

        const inicio =
            new Date(ai, mi-1, di);

        const fim =
            new Date(af, mf-1, df);

        inicio.setHours(0,0,0,0);
        fim.setHours(23,59,59,999);

        if(
            data >= inicio &&
            data <= fim
        ){
            return `${i + 1}`;
        }

    }

    return "FORA";
}

