    margin-bottom:5px;

}

.estatistica-header p{
    color:#666;
    font-size:15px;
}

.estatistica-cards{
    display:grid;
    grid-template-columns:
        repeat(auto-fit,minmax(180px,1fr));
    gap:15px;
    margin:20px;
}

.estat-card{
    background:var(--surface);
    color:var(--text);
    border-radius:12px;
    padding:20px;
