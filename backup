  cursor: pointer;

  font-weight: bold;
}

/* BOTÕES RELATÓRIO */

#botoesRelatorio button{
  transition:.2s;
}

#botoesRelatorio button:hover{
  transform:translateY(-1px);
}

/* RODAPÉ */

.ifro-footer{
