function obterInicioSemana(dataBR) {

    const [d,m,a] =
        dataBR.split("/");

    const dt =
        new Date(a,m-1,d);

    const diaSemana =
        dt.getDay();

    const ajuste =
        diaSemana === 0
            ? -6
            : 1 - diaSemana;

    dt.setDate(
        dt.getDate() + ajuste
    );

    return dt.toLocaleDateString("pt-BR");
}

