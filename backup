body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
}

/* HEADER */
.header {
  background: linear-gradient(135deg, #0f172a, #1e293b);
  color: white;
  padding: 16px 24px;
}

.header-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.brand-title {
  font-size: 18px;
  font-weight: bold;
}

.brand-subtitle {
  font-size: 12px;
  opacity: 0.8;
}

/* TABS */
.tabs {
  display: flex;
  gap: 8px;
  padding: 10px;
  background: var(--surface);
  border-bottom: 1px solid #e5e7eb;
  overflow-x: auto;
  position: sticky;
  top: 0;
  z-index: 5000;
}

.tab {
  border: none;
  background: #f3f4f6;
  padding: 10px 14px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 13px;
  white-space: nowrap;
  transition: 0.2s;
}

.tab:hover {
  background: #e5e7eb;
}

.tab.active {
  background: #2563eb;
  color: white;
}

/* BOTÃO TEMA */
.theme-btn {
  border: none;
  background: rgba(255,255,255,0.15);
  color: white;
  padding: 8px 10px;
  border-radius: 8px;
  cursor: pointer;
}

#tabelaEstatistica th {
    font-size: 16px;
