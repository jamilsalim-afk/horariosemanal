        a.data,
        a.modalidade
    );

const chave =
    `${disciplina}__${professor}__${a.turma}__${periodo}`;

        if (!mapa.has(chave)) {

            mapa.set(chave, {

    disciplina,
    professor,
    turma: a.turma || "",
    modalidade: a.modalidade || "",
    periodo,

    inicio: data,
    fim: data

});

        } else {

            const atual =
                mapa.get(chave);

            if (data) {

                if (!atual.inicio || data < atual.inicio)
                    atual.inicio = data;

                if (!atual.fim || data > atual.fim)
                    atual.fim = data;

            }

            if (
                atual.modalidade !== a.modalidade
            ) {

                atual.modalidade = "TODOS";

            }

        }

    });

    RELATORIO_DISCIPLINAS =
        Array.from(mapa.values());

    RELATORIO_DISCIPLINAS.sort(
        (a, b) =>
            a.disciplina.localeCompare(
                b.disciplina,
                "pt-BR"
            )
    );

    console.log(
        "CACHE RELATÓRIO:",
        RELATORIO_DISCIPLINAS.length
    );
}

function montarRelatorioDisciplinas(
    filtroModalidade = "TODOS",
    termoBusca = ""
) {

    const tabela =
        document.getElementById(
            "tabelaEstatistica"
        );

    let dados =
        [...RELATORIO_DISCIPLINAS];

    // ==========================
    // MODALIDADE
    // ==========================

    if (
        filtroModalidade &&
        filtroModalidade !== "TODOS"
    ) {

        dados = dados.filter(item => {

            if (
                item.modalidade === "TODOS"
            )
                return true;

            return (
                item.modalidade ===
                filtroModalidade
            );

        });

    }

    // ==========================
    // BUSCA
    // ==========================

    if (
        termoBusca &&
        termoBusca.trim()
    ) {

        const termo =
            normalizarTexto(
                termoBusca
            );

        dados = dados.filter(item =>

            normalizarTexto(
                item.disciplina
            ).includes(termo)

            ||

            normalizarTexto(
                item.professor
            ).includes(termo)

            ||

            normalizarTexto(
                item.turma
            ).includes(termo)

        );

    }

    // ==========================
    // RENDER
    // ==========================

    tabela.innerHTML = "";

    const fragment =
        document.createDocumentFragment();

    dados.forEach(item => {

        const tr =
            document.createElement("tr");

        const periodo =
            item.inicio && item.fim
                ? `${formatarData(item.inicio)} → ${formatarData(item.fim)}`
                : "-";

        tr.innerHTML = `
    <td>${item.disciplina}</td>
    <td>${item.professor}</td>
    <td>${item.turma}</td>
    <td>${item.periodo}</td>
    <td class="coluna-periodo">${periodo}</td>
`;

        fragment.appendChild(tr);

    });

    tabela.appendChild(fragment);

    return dados;
}

function parseDataBR(str) {
    if (!str) return null;
    const [d, m, a] = str.split('/');
    const dt = new Date(a, m - 1, d);
    dt.setHours(0, 0, 0, 0);
    return dt;
}

function formatarData(date) {
    if (!date) return "-";
    const d = String(date.getDate()).padStart(2, "0");
    const m = String(date.getMonth() + 1).padStart(2, "0");
    const a = date.getFullYear();
    return `${d}/${m}/${a}`;
}
  
